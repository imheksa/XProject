# Postgres connection string (e.g. from Railway's Postgres plugin).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# X Developer Portal (developer.x.com) -> your App -> "User authentication settings"
# Set up OAuth 2.0, type "Web App", and add X_REDIRECT_URI as a callback URL.
# Requires Basic tier or higher for follower/following list + follow/unfollow endpoints.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# Generate with: openssl rand -base64 32
SESSION_SECRET=""
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Optional: minimum milliseconds between individual follow/unfollow/block API
# calls made by the background worker (conservative pacing, independent of
# live 429 rate-limit handling). Default 3000.
MIN_ACTION_INTERVAL_MS="3000"

# Optional: required bearer token for POST /api/jobs/tick, only needed if you
# deploy without a long-running Node process and drive the queue via an
# external cron instead of the built-in in-process worker.
CRON_SECRET=""
